---
import { siteRoutes, type SiteRoutePath } from "../../config/routes";
import { businessIdentity } from "../../data/business";
import OlympiaLogo from "../brand/OlympiaLogo.astro";
import Container from "../primitives/Container.astro";
import PrimaryNav from "./PrimaryNav.astro";
import PerformanceRail from "./PerformanceRail.astro";

interface Props {
  currentPath: SiteRoutePath;
}

const { currentPath }: Props = Astro.props;
---

<header class="site-header">
  <PerformanceRail />
  <Container class="site-header__inner" size="wide">
    <a
      class="site-header__brand"
      href={siteRoutes.home.path}
      aria-label={`${businessIdentity.name} home`}
    >
      <OlympiaLogo />
    </a>
    <PrimaryNav currentPath={currentPath} />
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--layer-raised);
    border-block-end: var(--border-thin) solid rgb(255 255 255 / 7%);
    background: rgb(7 16 14 / 82%);
    backdrop-filter: blur(1rem);
  }

  .site-header__inner {
    position: relative;
    display: grid;
    min-block-size: 4.8rem;
    padding-block: var(--space-3);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
  }

  .site-header__brand {
    display: inline-flex;
    inline-size: clamp(8.75rem, 9vw + 6rem, 13rem);
    block-size: 3.35rem;
    align-items: center;
    text-decoration: none;
    transition: filter var(--duration-standard) var(--ease-standard);
  }

  .site-header__brand:hover {
    filter: drop-shadow(0 0 0.75rem rgb(217 31 61 / 34%)) brightness(1.08);
  }

  @media (max-width: 23rem) {
    .site-header__brand {
      inline-size: 7.75rem;
    }
  }
</style>
