---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { businessAddress, businessIdentity } from "../../data/business";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";

interface Props {
  eyebrow: string;
  heading: string;
  headingId: string;
  description: string;
  media?: ImageMetadata;
  mediaAlt?: string;
  mediaCaption?: string;
  accent?: "lime" | "coral";
}

const {
  eyebrow,
  heading,
  headingId,
  description,
  media,
  mediaAlt = "",
  mediaCaption,
  accent = "lime",
}: Props = Astro.props;
---

<Section
  class:list={["page-hero", `page-hero--${accent}`]}
  aria-labelledby={headingId}
>
  <Container size="wide">
    <div class="page-hero__grid">
      <div class="page-hero__content">
        <p class="page-hero__eyebrow">{eyebrow}</p>
        <h1 id={headingId}>{heading}</h1>
        <p class="page-hero__description">{description}</p>
        <div class="page-hero__actions u-cluster">
          <slot name="actions" />
        </div>
      </div>

      {
        media ? (
          <figure class="page-hero__media">
            <Image
              src={media}
              alt={mediaAlt}
              widths={[480, 720, 960]}
              sizes="(min-width: 64rem) 38vw, 92vw"
              loading="eager"
              fetchpriority="high"
              quality={84}
            />
            {mediaCaption && <figcaption>{mediaCaption}</figcaption>}
          </figure>
        ) : (
          <aside class="page-hero__marker" aria-label="Page summary">
            <p>Built for better training</p>
            <strong>{businessIdentity.name}</strong>
            <span>Strength · Fitness · Movement</span>
            <small>
              {businessAddress.locality}, {businessAddress.country}
            </small>
          </aside>
        )
      }
    </div>
  </Container>
</Section>

<style>
  :global(.page-hero) {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 86% 30%,
        rgb(201 255 98 / 8%),
        transparent 26rem
      ),
      var(--color-canvas);
  }

  :global(.page-hero--coral) {
    background:
      radial-gradient(
        circle at 86% 30%,
        rgb(255 121 100 / 10%),
        transparent 28rem
      ),
      var(--color-canvas);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-10);
  }

  .page-hero__content {
    display: grid;
    max-inline-size: 52rem;
    gap: var(--space-6);
  }

  .page-hero__eyebrow,
  .page-hero__marker p,
  .page-hero__marker span,
  .page-hero__marker small {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .page-hero__eyebrow,
  .page-hero__marker span {
    color: var(--color-accent);
  }

  .page-hero--coral .page-hero__eyebrow {
    color: var(--color-coral);
  }

  .page-hero__description {
    color: var(--color-text-muted);
    font-size: var(--text-lead);
  }

  .page-hero__actions {
    --cluster-gap: var(--space-3);
  }

  .page-hero__marker {
    position: relative;
    display: grid;
    padding: var(--space-8);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(20 35 31 / 72%);
    gap: var(--space-3);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .page-hero__marker::before {
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: var(--space-8);
    inline-size: 4rem;
    block-size: 3px;
    background: var(--color-accent);
    content: "";
  }

  .page-hero__marker::after {
    position: absolute;
    inset-block-end: -5rem;
    inset-inline-end: -5rem;
    inline-size: 13rem;
    block-size: 13rem;
    border: var(--border-thin) solid rgb(201 255 98 / 18%);
    border-radius: 50%;
    box-shadow:
      0 0 0 2rem rgb(201 255 98 / 2.5%),
      0 0 0 4rem rgb(201 255 98 / 1.5%);
    content: "";
    pointer-events: none;
    animation: marker-orbit 7s var(--ease-standard) infinite alternate;
  }

  .page-hero__marker p,
  .page-hero__marker small {
    color: var(--color-text-muted);
  }

  .page-hero__marker strong {
    margin-block: var(--space-4);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 3vw, 5.75rem);
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
  }

  .page-hero__media {
    position: relative;
    margin: 0;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .page-hero__media::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: var(--border-thin) solid var(--color-coral);
    border-radius: var(--radius-xl);
    content: "";
    opacity: 0.55;
    pointer-events: none;
    transform: scale(0.965);
  }

  .page-hero__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      145deg,
      transparent 48%,
      rgb(255 121 100 / 8%) 100%
    );
    content: "";
    pointer-events: none;
  }

  .page-hero__media :global(img) {
    inline-size: 100%;
    max-block-size: 43rem;
    border-radius: var(--radius-xl);
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }

  .page-hero__media figcaption {
    position: absolute;
    display: grid;
    inset-block-end: var(--space-4);
    inset-inline: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin) solid rgb(255 255 255 / 13%);
    border-radius: var(--radius-md);
    background: rgb(7 16 14 / 86%);
    backdrop-filter: blur(0.75rem);
    gap: var(--space-1);
  }

  .page-hero__media figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .page-hero__marker small {
    padding-block-start: var(--space-4);
    margin-block-start: var(--space-2);
    border-block-start: var(--border-thin) solid var(--color-border);
  }

  @keyframes marker-orbit {
    to {
      opacity: 0.55;
      transform: translate(-0.75rem, -0.75rem) scale(1.08);
    }
  }

  @media (min-width: 48rem) {
    .page-hero__marker {
      padding: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
      gap: var(--space-16);
      align-items: center;
    }

    .page-hero__media {
      margin-block: -2rem;
    }
  }
</style>
