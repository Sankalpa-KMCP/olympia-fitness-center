---
import { businessAddress, businessIdentity } from "../../data/business";
import { formatPostalAddress } from "../../utils/business-formatting";

const postalAddress = formatPostalAddress(businessAddress);
---

<div class="visit-details" aria-label="Visit details">
  <article aria-labelledby="street-address-heading">
    <p>Street address</p>
    <h3 id="street-address-heading">Visit {businessIdentity.name}</h3>
    <address>{postalAddress}</address>
  </article>

  <article aria-labelledby="plus-code-heading">
    <p>Plus Code</p>
    <h3 id="plus-code-heading">Location reference</h3>
    <code>{businessAddress.plusCode}</code>
    <span>
      Select this text and enter it into a map service manually when useful.
    </span>
  </article>
</div>

<style>
  .visit-details {
    display: grid;
    gap: var(--space-4);
  }

  .visit-details article {
    position: relative;
    display: grid;
    min-block-size: 100%;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    gap: var(--space-4);
  }

  .visit-details article::before {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-start: var(--space-6);
    inline-size: 3rem;
    block-size: 3px;
    background: var(--color-accent);
    content: "";
  }

  .visit-details article > p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .visit-details h3 {
    font-size: var(--text-heading-sm);
  }

  .visit-details address,
  .visit-details article > span {
    color: var(--color-text-muted);
    font-style: normal;
  }

  .visit-details code {
    display: block;
    max-inline-size: 100%;
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-lead);
    font-weight: 700;
    overflow-wrap: anywhere;
    user-select: text;
  }

  @media (min-width: 48rem) {
    .visit-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .visit-details article {
      padding: var(--space-8);
    }
  }
</style>
