---
import { businessAddress, businessIdentity } from "../../data/business";
---

<div class="visit-details" aria-label="Visit details">
  <article aria-labelledby="street-address-heading">
    <p>Street address</p>
    <h3 id="street-address-heading">Visit {businessIdentity.name}</h3>
    <address>
      {businessAddress.streetAddress}, {businessAddress.locality}, {
        businessAddress.country
      }
    </address>
  </article>

  <article aria-labelledby="plus-code-heading">
    <p>Plus Code</p>
    <h3 id="plus-code-heading">Find the exact location</h3>
    <span class="visit-details__plus-code">{businessAddress.plusCode}</span>
  </article>

  <article aria-labelledby="arrival-heading">
    <p>First visit</p>
    <h3 id="arrival-heading">Arrive ready to train</h3>
    <span>
      Use the map above for directions, and call ahead if you would like to
      confirm opening hours or ask about joining.
    </span>
  </article>
</div>

<style>
  .visit-details {
    display: grid;
    gap: var(--space-4);
  }

  .visit-details article {
    position: relative;
    display: grid;
    min-block-size: 100%;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    gap: var(--space-4);
  }

  .visit-details article::before {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-start: var(--space-6);
    inline-size: 3rem;
    block-size: 3px;
    background: var(--color-accent);
    content: "";
  }

  .visit-details article > p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .visit-details h3 {
    font-size: var(--text-heading-sm);
  }

  .visit-details address,
  .visit-details article > span {
    color: var(--color-text-muted);
    font-style: normal;
  }

  .visit-details__plus-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media (min-width: 48rem) {
    .visit-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .visit-details article {
      padding: var(--space-8);
    }

    .visit-details article:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
