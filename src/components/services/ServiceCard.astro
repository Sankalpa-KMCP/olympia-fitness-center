---
import type { ServiceCategory } from "../../types/business";

interface Props {
  service: ServiceCategory;
  description: string;
  index: number;
}

const { service, description, index }: Props = Astro.props;
const displayIndex = String(index + 1).padStart(2, "0");
---

<article class="service-card" id={service.id}>
  <p aria-hidden="true">{displayIndex}</p>
  <h3>{service.label}</h3>
  <span>{description}</span>
</article>

<style>
  .service-card {
    position: relative;
    display: grid;
    min-block-size: 100%;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 2%);
    gap: var(--space-4);
    overflow: hidden;
    transition:
      transform var(--duration-standard) var(--ease-standard),
      border-color var(--duration-standard) var(--ease-standard),
      background-color var(--duration-standard) var(--ease-standard);
  }

  .service-card::after {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-end: var(--space-6);
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
    opacity: 0.08;
    transform: scale(1);
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .service-card:hover::after {
    transform: scale(6);
  }

  .service-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-raised);
    transform: translateY(-4px);
  }

  .service-card:nth-child(3n + 2)::after {
    background: var(--color-coral);
  }

  .service-card:nth-child(3n + 2) p {
    color: var(--color-coral);
  }

  .service-card p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
  }

  .service-card > * {
    position: relative;
    z-index: 1;
  }

  .service-card h3 {
    font-size: var(--text-heading-sm);
  }

  .service-card span {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .service-card {
      padding: var(--space-8);
    }
  }
</style>
