---
import { siteRoutes } from "../../config/routes";
import ButtonLink from "../primitives/ButtonLink.astro";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import SectionHeading from "./SectionHeading.astro";

const headingId = "inside-olympia-heading";
---

<Section class="visual-story" aria-labelledby={headingId}>
  <Container size="wide">
    <div class="visual-story__intro">
      <SectionHeading
        eyebrow="The Olympia experience"
        heading="Serious training. Real energy."
        headingId={headingId}
        description="A focused floor for independent sessions, coached training, and high-energy group movement in Wadduwa."
      />
      <ButtonLink href={siteRoutes.contact.path} variant="secondary">
        See the gym in person
      </ButtonLink>
    </div>
  </Container>
</Section>

<style>
  .visual-story__intro {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  .visual-story__intro .button-link {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .visual-story__intro {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
