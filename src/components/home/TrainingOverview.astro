---
import { businessIdentity } from "../../data/business";
import { facilityClaims, serviceCategories } from "../../data/services";
import ButtonLink from "../primitives/ButtonLink.astro";
import Container from "../primitives/Container.astro";
import Section from "../primitives/Section.astro";
import { siteRoutes } from "../../config/routes";
import SectionHeading from "./SectionHeading.astro";

const headingId = "training-overview-heading";
const facilityHeadingId = "facility-claims-heading";
---

<Section
  id="training"
  tone="surface"
  aria-labelledby={headingId}
  class="training-overview"
>
  <Container size="wide">
    <SectionHeading
      eyebrow="Training scope"
      heading="Different goals. One place to train."
      headingId={headingId}
      description="Explore the available training categories, from general fitness to focused strength and physique goals."
    />

    <div class="training-overview__grid">
      <ol class="training-overview__services" aria-label="Training categories">
        {
          serviceCategories.map((service, index) => (
            <li>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <strong>{service.label}</strong>
            </li>
          ))
        }
      </ol>

      <aside
        class="training-overview__facilities"
        aria-labelledby={facilityHeadingId}
      >
        <p class="training-overview__label">Business-provided information</p>
        <h3 id={facilityHeadingId}>Training environment</h3>
        <p>
          These facility details were supplied by {businessIdentity.name}.
        </p>
        <ul>
          {facilityClaims.items.map((claim) => <li>{claim}</li>)}
        </ul>
      </aside>
    </div>

    <ButtonLink href={siteRoutes.services.path} variant="secondary">
      Explore services
    </ButtonLink>
  </Container>
</Section>

<style>
  :global(.training-overview) {
    overflow: hidden;
  }

  :global(.training-overview)::after {
    position: absolute;
    z-index: 0;
    inset-block-start: -0.18em;
    inset-inline-end: -0.04em;
    color: rgb(201 255 98 / 3.5%);
    content: "07";
    font-family: var(--font-display);
    font-size: clamp(16rem, 40vw, 40rem);
    font-weight: 800;
    letter-spacing: -0.1em;
    line-height: 0.8;
    pointer-events: none;
  }

  .training-overview :global(.u-container) {
    position: relative;
    z-index: 1;
  }

  .training-overview__grid {
    display: grid;
    margin-block: var(--space-10);
    gap: var(--space-8);
  }

  .training-overview__services {
    display: grid;
    padding: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .training-overview__services li {
    display: grid;
    max-inline-size: none;
    min-block-size: var(--target-min);
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 2%);
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    transition:
      border-color var(--duration-standard) var(--ease-standard),
      transform var(--duration-standard) var(--ease-standard);
  }

  .training-overview__services li:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
  }

  .training-overview__services span,
  .training-overview__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .training-overview__services strong {
    font-size: var(--text-lead);
  }

  .training-overview__facilities {
    position: relative;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .training-overview__facilities::before {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-start: var(--space-6);
    inline-size: 3rem;
    block-size: 3px;
    background: var(--color-accent);
    content: "";
  }

  .training-overview__facilities h3 {
    margin-block-start: var(--space-4);
  }

  .training-overview__facilities > p:not(.training-overview__label) {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
  }

  .training-overview__facilities ul {
    display: grid;
    padding: 0;
    margin-block-start: var(--space-6);
    gap: var(--space-3);
    list-style: none;
  }

  .training-overview__facilities li {
    display: grid;
    max-inline-size: none;
    grid-template-columns: var(--space-4) minmax(0, 1fr);
    gap: var(--space-3);
  }

  .training-overview__facilities li::before {
    color: var(--color-accent);
    content: "+";
    font-family: var(--font-mono);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .training-overview__services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .training-overview__services li:nth-child(odd) {
      padding-inline-end: var(--space-5);
    }

    .training-overview__services li:nth-child(even) {
      padding-inline-start: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .training-overview__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(19rem, 0.7fr);
      align-items: start;
    }

    .training-overview__facilities {
      padding: var(--space-8);
    }
  }
</style>
