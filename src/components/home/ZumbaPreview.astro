---
import { siteRoutes } from "../../config/routes";
import { zumbaSchedule } from "../../data/zumba";
import {
  formatDayGroup,
  formatLocalTime,
} from "../../utils/business-formatting";
import ButtonLink from "../primitives/ButtonLink.astro";

const headingId = "zumba-preview-heading";
---

<article class="zumba-preview" aria-labelledby={headingId}>
  <p class="zumba-preview__label">Class schedule</p>
  <h3 id={headingId}>Zumba preview</h3>
  <p class="zumba-preview__intro">Current weekly Zumba class times.</p>

  <dl>
    {
      zumbaSchedule.map((session) => (
        <div>
          <dt>{formatDayGroup(session.days)}</dt>
          <dd>
            <time datetime={session.period.opens}>
              {formatLocalTime(session.period.opens)}
            </time>
            <span aria-hidden="true">–</span>
            <span class="u-sr-only"> to </span>
            <time datetime={session.period.closes}>
              {formatLocalTime(session.period.closes)}
            </time>
          </dd>
        </div>
      ))
    }
  </dl>

  <ButtonLink href={siteRoutes.zumba.path} variant="secondary">
    View Zumba details
  </ButtonLink>
</article>

<style>
  .zumba-preview {
    display: grid;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 100% 0%,
        rgb(255 121 100 / 12%),
        transparent 14rem
      ),
      var(--color-surface);
    gap: var(--space-4);
  }

  .zumba-preview__label {
    color: var(--color-coral);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .zumba-preview__intro {
    color: var(--color-text-muted);
  }

  .zumba-preview dl {
    display: grid;
    margin-block: var(--space-2);
    border-block-start: var(--border-thin) solid var(--color-border);
  }

  .zumba-preview dl > div {
    display: grid;
    padding-block: var(--space-4);
    border-block-end: var(--border-thin) solid var(--color-border);
    gap: var(--space-1);
  }

  .zumba-preview dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .zumba-preview dd {
    max-inline-size: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .zumba-preview .button-link {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .zumba-preview {
      padding: var(--space-8);
    }

    .zumba-preview dl > div {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-4);
      align-items: baseline;
    }
  }
</style>
