---
import type { HTMLAttributes } from "astro/types";

type ButtonLinkVariant = "primary" | "secondary";
type AnchorAttributes = Omit<HTMLAttributes<"a">, "class" | "href">;

interface Props extends AnchorAttributes {
  href: string;
  variant?: ButtonLinkVariant;
  class?: string;
}

const {
  href,
  variant = "primary",
  class: className,
  target,
  rel,
  ...attributes
} = Astro.props;

if (href.trim().length === 0) {
  throw new TypeError("ButtonLink requires a non-empty href.");
}

const safeRel =
  target === "_blank"
    ? [
        ...new Set([...(rel?.split(/\s+/) ?? []), "noopener", "noreferrer"]),
      ].join(" ")
    : rel;
---

<a
  class:list={["button-link", `button-link--${variant}`, className]}
  href={href}
  target={target}
  rel={safeRel}
  {...attributes}
>
  <slot />
</a>

<style>
  .button-link {
    display: inline-flex;
    min-block-size: var(--target-min);
    padding: 0.9rem 1.35rem;
    border: var(--border-thin) solid transparent;
    border-radius: var(--radius-pill);
    align-items: center;
    justify-content: center;
    color: var(--color-on-accent);
    font-size: var(--text-sm);
    font-weight: 720;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-standard) var(--ease-standard);
  }

  .button-link--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0.75rem 2rem rgb(201 255 98 / 12%);
  }

  .button-link--primary:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-on-accent);
    box-shadow: 0 1rem 2.5rem rgb(201 255 98 / 20%);
    transform: translateY(-2px);
  }

  .button-link--secondary {
    background: rgb(255 255 255 / 3%);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .button-link--secondary:hover {
    background: var(--color-surface-raised);
    border-color: var(--color-text-muted);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .button-link:active {
    transform: translateY(1px);
  }
</style>
