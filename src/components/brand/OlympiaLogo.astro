---
interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<svg
  class:list={["olympia-logo", className]}
  viewBox="0 0 430 150"
  role="img"
  aria-label="Olympia Fitness"
  xmlns="http://www.w3.org/2000/svg"
>
  <g transform="rotate(-13 180 73)" aria-hidden="true">
    <ellipse
      cx="180"
      cy="73"
      rx="104"
      ry="54"
      fill="none"
      stroke="#f6f2e9"
      stroke-width="18"></ellipse>
    <ellipse
      cx="180"
      cy="73"
      rx="104"
      ry="54"
      fill="none"
      stroke="#c9ff62"
      stroke-width="10"></ellipse>
  </g>

  <g
    aria-hidden="true"
    font-family="Georgia, 'Times New Roman', serif"
    font-style="italic"
    font-weight="900"
  >
    <text
      x="12"
      y="98"
      font-size="80"
      textLength="408"
      lengthAdjust="spacingAndGlyphs"
      fill="#f6f2e9"
      stroke="#07100e"
      stroke-width="12"
      paint-order="stroke fill">OLYMPIA</text
    >
    <text
      x="12"
      y="98"
      font-size="80"
      textLength="408"
      lengthAdjust="spacingAndGlyphs"
      fill="#f6f2e9"
      stroke="#c9ff62"
      stroke-width="5"
      paint-order="stroke fill">OLYMPIA</text
    >
  </g>

  <g aria-hidden="true" font-family="Arial Black, Arial, sans-serif">
    <text
      x="120"
      y="137"
      font-size="39"
      font-style="italic"
      font-weight="900"
      letter-spacing="1"
      textLength="220"
      lengthAdjust="spacingAndGlyphs"
      fill="#c9ff62"
      stroke="#07100e"
      stroke-width="10"
      paint-order="stroke fill">FITNESS</text
    >
    <text
      x="120"
      y="137"
      font-size="39"
      font-style="italic"
      font-weight="900"
      letter-spacing="1"
      textLength="220"
      lengthAdjust="spacingAndGlyphs"
      fill="#c9ff62"
      stroke="#f6f2e9"
      stroke-width="4"
      paint-order="stroke fill">FITNESS</text
    >
    <text
      x="228"
      y="46"
      font-size="20"
      font-style="italic"
      font-weight="900"
      fill="#f6f2e9"
      stroke="#07100e"
      stroke-width="5"
      paint-order="stroke fill">2025</text
    >
    <text
      x="228"
      y="46"
      font-size="20"
      font-style="italic"
      font-weight="900"
      fill="#c9ff62">2025</text
    >
  </g>
</svg>

<style>
  .olympia-logo {
    display: block;
    inline-size: auto;
    block-size: 100%;
    overflow: visible;
  }
</style>
