---
import { Image } from "astro:assets";
import trainingHero from "../assets/training-hero.png";
import ContactActions from "../components/business/ContactActions.astro";
import HoursDisplay from "../components/business/HoursDisplay.astro";
import SectionHeading from "../components/home/SectionHeading.astro";
import TrainingOverview from "../components/home/TrainingOverview.astro";
import ZumbaPreview from "../components/home/ZumbaPreview.astro";
import ButtonLink from "../components/primitives/ButtonLink.astro";
import Container from "../components/primitives/Container.astro";
import Section from "../components/primitives/Section.astro";
import { siteRoutes } from "../config/routes";
import {
  businessAddress,
  businessIdentity,
  primaryContact,
} from "../data/business";
import { facilityClaims, serviceCategories } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostalAddress } from "../utils/business-formatting";
import { createTelHref } from "../utils/contact-links";

const route = siteRoutes.home;
const telephoneHref = createTelHref(primaryContact.phone.international);
const postalAddress = formatPostalAddress(businessAddress);
const serviceLabels = Object.fromEntries(
  serviceCategories.map((service) => [service.id, service.label]),
) as Record<(typeof serviceCategories)[number]["id"], string>;
const heroServiceOrder = [
  "general-fitness",
  "strength-training",
  "physique-training",
  "bodybuilding",
  "muscle-gain",
  "weight-loss",
  "personal-training-enquiries",
] as const satisfies readonly (typeof serviceCategories)[number]["id"][];
const heroPositioning = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
}).format(
  heroServiceOrder.map((serviceId) => serviceLabels[serviceId].toLowerCase()),
);
const homepageDescription = `Explore ${serviceCategories
  .map((service) => service.label.toLowerCase())
  .join(
    ", ",
  )} at ${businessIdentity.name}, a ${businessIdentity.category.toLowerCase()} in ${businessAddress.locality}.`;
---

<BaseLayout
  title={`Gym and fitness training in ${businessAddress.locality}`}
  description={homepageDescription}
  currentPath={route.path}
  indexing="noindex"
>
  <Section class="home-hero" aria-labelledby="home-heading">
    <Container size="wide">
      <div class="home-hero__grid">
        <div class="home-hero__copy">
          <p class="home-hero__eyebrow">
            {businessAddress.locality}, {businessAddress.country} / {
              businessIdentity.category
            }
          </p>
          <h1 id="home-heading">
            <span>{businessIdentity.name}</span>
            Train with <em>purpose.</em><br />Move with confidence.
          </h1>
          <p class="home-hero__lead">
            Training options include {heroPositioning}.
          </p>

          <ul
            class="home-hero__scope"
            aria-label="Available training categories"
          >
            {serviceCategories.map((service) => <li>{service.label}</li>)}
          </ul>

          <div class="home-hero__actions u-cluster">
            <ButtonLink href={telephoneHref}>
              Call {primaryContact.phone.display}
            </ButtonLink>
            <ButtonLink href={siteRoutes.services.path} variant="secondary">
              Explore services
            </ButtonLink>
          </div>
        </div>

        <div class="home-hero__visual">
          <figure>
            <Image
              src={trainingHero}
              alt="Athlete training with cable equipment in a modern gym setting"
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 64rem) 54vw, 94vw"
              loading="eager"
              fetchpriority="high"
              quality={86}
            />
            <figcaption>AI-generated editorial image</figcaption>
          </figure>
          <aside
            class="home-hero__environment"
            aria-labelledby="home-environment-heading"
          >
            <div class="home-hero__locator" aria-label="Location reference">
              <span>{businessAddress.postalCode}</span>
              <strong>{businessAddress.locality}</strong>
            </div>
            <p class="home-hero__panel-label">Gym-provided information</p>
            <h2 id="home-environment-heading">A focused place to train.</h2>
            <ul>
              {
                facilityClaims.items
                  .slice(0, 3)
                  .map((claim) => <li>{claim}</li>)
              }
            </ul>
          </aside>
        </div>
      </div>
      <p class="home-hero__scroll" aria-hidden="true">
        Explore Olympia
        <span></span>
      </p>
    </Container>
  </Section>

  <TrainingOverview />

  <Section id="visit" aria-labelledby="visit-heading" class="home-visit">
    <Container size="wide">
      <div class="home-visit__heading">
        <SectionHeading
          eyebrow="Plan your visit"
          heading="Train around a clear weekly schedule."
          headingId="visit-heading"
          description="Opening hours and current Zumba times are kept distinct so you can plan the right visit."
        />
        <div class="home-visit__address">
          <p>Find us in {businessAddress.locality}</p>
          <address>{postalAddress}</address>
          <ButtonLink href={siteRoutes.contact.path} variant="secondary">
            Contact and visit
          </ButtonLink>
        </div>
      </div>

      <div class="home-visit__grid">
        <article class="home-visit__hours" aria-label="Gym opening hours">
          <HoursDisplay headingLevel="h3" />
        </article>
        <ZumbaPreview />
      </div>
    </Container>
  </Section>

  <Section
    tone="surface"
    spacing="compact"
    class="home-enquiry"
    aria-labelledby="enquiry-heading"
  >
    <Container size="wide">
      <div class="home-enquiry__grid">
        <SectionHeading
          eyebrow="Direct enquiry"
          heading="Questions before you train?"
          headingId="enquiry-heading"
          description="Speak with the gym directly by telephone or email using the verified contact details below."
        />

        <div class="home-enquiry__actions">
          <ContactActions />
          <ButtonLink href={siteRoutes.contact.path} variant="secondary">
            Open contact page
          </ButtonLink>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  :global(.home-hero) {
    overflow: hidden;
    background:
      linear-gradient(
        90deg,
        transparent 0 67%,
        color-mix(in srgb, var(--color-accent) 5%, transparent) 67% 100%
      ),
      repeating-linear-gradient(
        135deg,
        transparent 0,
        transparent 1.5rem,
        color-mix(in srgb, var(--color-border) 10%, transparent) 1.5rem,
        color-mix(in srgb, var(--color-border) 10%, transparent) 1.5625rem
      );
  }

  :global(.home-hero)::before {
    position: absolute;
    inset-block: 0;
    inset-inline-start: max(
      var(--gutter),
      calc((100% - var(--width-wide)) / 2)
    );
    inline-size: var(--border-strong);
    background: var(--color-accent);
    content: "";
    opacity: 0.65;
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-10);
  }

  .home-hero__copy {
    display: grid;
    gap: var(--space-6);
  }

  .home-hero__eyebrow,
  .home-hero__panel-label,
  .home-visit__address > p {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-inline-size: 12ch;
  }

  .home-hero h1 span {
    display: block;
    margin-block-end: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-hero__lead {
    max-inline-size: 43rem;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
  }

  .home-hero__scope {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    gap: var(--space-2);
    list-style: none;
  }

  .home-hero__scope li {
    max-inline-size: none;
    padding: var(--space-2) var(--space-3);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .home-hero__actions {
    --cluster-gap: var(--space-3);

    margin-block-start: var(--space-2);
  }

  .home-hero__environment {
    position: relative;
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .home-hero__environment::after {
    position: absolute;
    inset-block-start: -1px;
    inset-inline: -1px;
    block-size: var(--space-1);
    background: var(--color-accent);
    content: "";
  }

  .home-hero__locator {
    display: flex;
    padding-block-end: var(--space-5);
    margin-block-end: var(--space-6);
    border-block-end: var(--border-thin) solid var(--color-border);
    gap: var(--space-4);
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--font-mono);
  }

  .home-hero__locator span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .home-hero__locator strong {
    color: var(--color-accent);
    font-size: var(--text-heading-sm);
    line-height: 1;
  }

  .home-hero__environment h2 {
    margin-block-start: var(--space-4);
    font-size: var(--text-heading-sm);
  }

  .home-hero__environment ul {
    display: grid;
    padding: 0;
    margin-block-start: var(--space-6);
    gap: var(--space-3);
    list-style: none;
  }

  .home-hero__environment li {
    display: grid;
    max-inline-size: none;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-thin) solid var(--color-border);
    grid-template-columns: var(--space-4) minmax(0, 1fr);
    gap: var(--space-3);
  }

  .home-hero__environment li::before {
    color: var(--color-accent);
    content: "/";
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .home-visit__heading {
    display: grid;
    gap: var(--space-8);
  }

  .home-visit__address {
    display: grid;
    padding-inline-start: var(--space-5);
    border-inline-start: var(--space-1) solid var(--color-accent);
    gap: var(--space-3);
    align-content: start;
  }

  .home-visit__address address {
    max-inline-size: 32rem;
    color: var(--color-text-muted);
    font-style: normal;
  }

  .home-visit__address .button-link {
    margin-block-start: var(--space-2);
    justify-self: start;
  }

  .home-visit__grid {
    display: grid;
    margin-block-start: var(--space-10);
    gap: var(--space-6);
  }

  .home-visit__hours {
    padding: var(--space-6);
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .home-enquiry__grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .home-enquiry__actions {
    display: grid;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-canvas);
    gap: var(--space-5);
  }

  .home-enquiry__actions .button-link {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .home-hero__environment,
    .home-visit__hours {
      padding: var(--space-8);
    }

    .home-visit__heading,
    .home-enquiry__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    }

    .home-visit__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  @media (min-width: 64rem) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.65fr);
      gap: var(--space-16);
      align-items: center;
    }

    .home-enquiry__actions {
      padding: var(--space-6);
    }
  }
</style>

<style>
  :global(.home-hero) {
    min-block-size: calc(100svh - 5.25rem);
    padding-block: clamp(3rem, 5vw, 5.5rem);
    background:
      radial-gradient(
        circle at 82% 24%,
        rgb(201 255 98 / 8%),
        transparent 30rem
      ),
      var(--color-canvas);
  }

  :global(.home-hero)::before {
    display: none;
  }

  .home-hero__grid {
    gap: clamp(3rem, 7vw, 7rem);
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
    align-content: center;
  }

  .home-hero h1 {
    max-inline-size: 10ch;
    font-size: var(--text-display);
    letter-spacing: -0.065em;
    overflow-wrap: normal;
  }

  .home-hero h1 em {
    color: var(--color-accent);
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .home-hero__lead {
    max-inline-size: 37rem;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
  }

  .home-hero__scope li {
    border-color: var(--color-border);
    background: rgb(255 255 255 / 3%);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
  }

  .home-hero__visual {
    position: relative;
    min-block-size: 35rem;
  }

  .home-hero__visual::before {
    position: absolute;
    z-index: -1;
    inset-block-start: 8%;
    inset-inline-end: -8%;
    inline-size: 60%;
    aspect-ratio: 1;
    border: var(--border-thin) solid rgb(201 255 98 / 16%);
    border-radius: 50%;
    box-shadow:
      0 0 0 3rem rgb(201 255 98 / 2%),
      0 0 0 7rem rgb(201 255 98 / 1.5%);
    content: "";
    animation: orbit-breathe 8s var(--ease-standard) infinite alternate;
  }

  .home-hero__visual figure {
    position: relative;
    block-size: 100%;
    min-block-size: 35rem;
    margin: 0;
  }

  .home-hero__visual figure::before {
    position: absolute;
    z-index: 1;
    inset: 1.25rem -1rem -1rem 1.25rem;
    border: var(--border-thin) solid rgb(201 255 98 / 42%);
    border-radius: var(--radius-xl);
    content: "";
    pointer-events: none;
  }

  .home-hero__visual figure::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: var(--radius-xl);
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgb(255 255 255 / 8%) 48%,
      transparent 61%
    );
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: translateX(-65%);
    animation: image-sheen 9s 1.5s var(--ease-standard) infinite;
  }

  .home-hero__visual :global(img) {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 35rem;
    border-radius: var(--radius-xl);
    object-fit: cover;
    object-position: 58% center;
    box-shadow: var(--shadow-md);
  }

  .home-hero__visual figcaption {
    position: absolute;
    z-index: 2;
    inset-block-start: var(--space-4);
    inset-inline-end: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgb(7 16 14 / 78%);
    color: var(--color-text-muted);
    font-size: 0.7rem;
    backdrop-filter: blur(0.75rem);
  }

  .home-hero__environment {
    z-index: 3;
    max-inline-size: 27rem;
    padding: var(--space-6);
    margin: -8rem auto 0 var(--space-5);
    border-color: rgb(255 255 255 / 12%);
    border-radius: var(--radius-lg);
    background: rgb(8 19 16 / 88%);
    backdrop-filter: blur(1.25rem);
  }

  .home-hero__environment::after {
    display: none;
  }

  .home-hero__environment h2 {
    font-size: clamp(1.55rem, 1.3rem + 0.8vw, 2.1rem);
  }

  .home-hero__scroll {
    display: none;
  }

  :global(.home-enquiry.section--surface) {
    border: 0;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  :global(.home-enquiry .section-heading__eyebrow),
  :global(.home-enquiry .section-heading__description),
  :global(.home-enquiry .contact-actions span),
  :global(.home-enquiry .contact-actions strong),
  :global(.home-enquiry .contact-actions a) {
    color: var(--color-on-accent);
  }

  :global(.home-enquiry .section-heading__eyebrow),
  :global(.home-enquiry .section-heading__description) {
    color: var(--color-on-accent) !important;
  }

  :global(.home-enquiry .section-heading__description) {
    opacity: 0.78;
  }

  :global(.home-enquiry .section-heading__eyebrow::before) {
    background: var(--color-on-accent);
  }

  :global(.home-enquiry .button-link--secondary) {
    border-color: rgb(16 32 6 / 48%);
    background: var(--color-on-accent);
    color: var(--color-text);
  }

  @keyframes orbit-breathe {
    to {
      opacity: 0.6;
      transform: scale(1.08) rotate(7deg);
    }
  }

  @keyframes image-sheen {
    0%,
    58% {
      opacity: 0;
      transform: translateX(-65%);
    }

    68% {
      opacity: 1;
    }

    82%,
    100% {
      opacity: 0;
      transform: translateX(65%);
    }
  }

  .home-visit__hours,
  .home-enquiry__actions {
    border-radius: var(--radius-lg);
    border-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 64rem) {
    .home-hero__grid {
      grid-template-columns: minmax(28rem, 0.9fr) minmax(32rem, 1.1fr);
      align-items: center;
    }

    .home-hero__visual {
      margin-inline-end: calc(-1 * var(--gutter));
    }

    .home-hero__scroll {
      display: flex;
      margin-block-start: var(--space-8);
      gap: var(--space-4);
      align-items: center;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .home-hero__scroll span {
      position: relative;
      inline-size: 5rem;
      block-size: 1px;
      background: var(--color-border-strong);
      overflow: hidden;
    }

    .home-hero__scroll span::after {
      position: absolute;
      inset: 0;
      background: var(--color-accent);
      content: "";
      transform: translateX(-100%);
      animation: scroll-cue 2.4s var(--ease-standard) infinite;
    }
  }

  @keyframes scroll-cue {
    50%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 39.999rem) {
    :global(.home-hero) {
      min-block-size: auto;
    }

    .home-hero h1 {
      font-size: clamp(3.4rem, 16vw, 5.2rem);
    }

    .home-hero__visual,
    .home-hero__visual figure,
    .home-hero__visual :global(img) {
      min-block-size: 27rem;
    }

    .home-hero__environment {
      margin: -4rem var(--space-3) 0;
    }
  }
</style>
